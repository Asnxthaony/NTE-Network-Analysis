namespace gateway;

// MSG_ID: 1106
table ClientLoginReq {
  client_version: string;   // 20191124
  username: string;         // 9_123456789
  password: string;         // token
  login_type: int32;        // PwrdOneSDKLogin(2)
  unk_1: string;            // 
  one_app_id: string;       // 1289
  channel_platform: string; // laohu_9
  channel_media_id: string; // 9_9
  unk_2: string;            // 
  client_wan_ip: string;    // 
  device_id_1: string;      // 
  device_id_2: string;      // 
  device_model: string;     // Microsoft Windows 11 专业版 / 2512BPNDAC
  device_sys: string;       // 10.0.26300 / 17
  device_memory: int32;     // MemStats.AvailablePhysical
  os_type: int32;           // IOS(1), Android(2), PC(4), Harmony(18)
  unk_3: int32;             // 
  unk_4: string;            // 
}

// MSG_ID: 1113
table ServerErrorMsgCmd {
  msg: string; // forbidden login by white list!
}

// MSG_ID: 1117
table ClientTravelCmd {
  login_obj_id: uint64; // 114514
  uid: string;          // 9_123456789
  unk_1: string;        // 
  save_info: string;    // TagOthers
  server_addr: string;  // 1.2.3.4:8888
  location: string;     // X,Y,Z|Pitch,Yaw,Roll|ScaleX,ScaleY,ScaleZ
  unk_2: string;        // 
  role_id: uint64;      // 2233****6666
  character_bp: string; // /Game/Blueprints/Character/Player/player_010_nanally.player_010_nanally_C
  unk_3: string;        // 
  unk_4: int32;         // 
  unk_5: int32;         // 1 / 3
  unk_6: bool;          // true
  unk_7: int32;         // 
}

// MSG_ID: 1120
table ServerVersionCmd {
  server_version: string;       // 20200704
  client_wan_ip: string;        // 8.8.8.8
  client_wan_port: int32;       // 6666
  heart_type: uint8;            // Disable(0), Check_Alive(1), Tracert(2)
  heart_client_interval: int32; // 15
  check_server_interval: int32; // 300
  server_id: int32;             // 14001
  server_time_utc: int64;       // 
  server_time: int64;           // 
  unk_1: [ubyte];               // 
  map_name: string;             // XL_map_bigworld_test
}

// MSG_ID: 1121
table ClientKeepAliveCmd {
  client_tick: uint32; // PerformanceCount.LowPart
}

// MSG_ID: 1122
table ServerKeepAliveCmd {
  server_tick: uint32;
  server_time_utc: int64;
  server_time: int64;
}

// MSG_ID: 1133
table ClientLogoutReq {
  reason: string; // return-main-menu
}

// MSG_ID: 1134
table ClientLogoutRes {
  msg: string; // NoError
}
